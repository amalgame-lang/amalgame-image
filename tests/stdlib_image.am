// Stdlib test: Amalgame.Image — image decode + encode via the
// vendored stb_image / stb_image_write headers. Self-contained
// (no network), deterministic for the lossless formats.
//
// Fixture: tests/run_tests.sh generates /tmp/amc_img_fixture.png
// (4×2 RGBA) before invoking the test. Pixels:
//   row 0: red opaque, green opaque, blue opaque, white opaque
//   row 1: black opaque, gray opaque, white half, fully transparent
// Same image is regenerated each run — no checked-in binary.

namespace Tests

import Amalgame.Image

public class Program {
    public static void Main(string[] args) {

        // Pixel literals — Amalgame doesn't parse hex (0xFF reads
        // as 0), and AM bit-shifts lower to C `int << int` that
        // overflows for `255 << 24` before the i64 promotion. So
        // we hard-code the packed RGBA values in decimal — they
        // ARE i64 literals in AM.
        // Layout: 0xRRGGBBAA → (R*16777216) + (G*65536) + (B*256) + A
        let RED:    int = 4278190335    // 0xFF0000FF
        let GREEN:  int = 16711935      // 0x00FF00FF
        let BLUE:   int = 65535         // 0x0000FFFF
        let WHITE:  int = 4294967295    // 0xFFFFFFFF
        let MAGENTA_HALF: int = 4278255488    // 0xFF00FF80

        // ── 1. Load fixture ────────────────────────────────────

        let img = Image.Load("/tmp/amc_img_fixture.png")
        if (Image.IsValid(img)) {
            Console.WriteLine("[PASS] load fixture")
        } else {
            Console.WriteLine("[FAIL] load: " + Image.LastError(img))
            return
        }

        // ── 2. Geometry ────────────────────────────────────────

        if (Image.Width(img) == 4 && Image.Height(img) == 2) {
            Console.WriteLine("[PASS] geometry 4x2")
        } else {
            Console.WriteLine("[FAIL] geometry got "
                + String_FromInt(Image.Width(img)) + "x"
                + String_FromInt(Image.Height(img)))
        }

        // Source channels — fixture is RGBA so channels==4.
        if (Image.Channels(img) == 4) {
            Console.WriteLine("[PASS] channels 4")
        } else {
            Console.WriteLine("[FAIL] channels got "
                + String_FromInt(Image.Channels(img)))
        }

        // ── 3. Pixel reads — fixture's known palette ──────────

        let p00: int = Image.GetPixel(img, 0, 0)
        let p10: int = Image.GetPixel(img, 1, 0)
        let p20: int = Image.GetPixel(img, 2, 0)
        let p30: int = Image.GetPixel(img, 3, 0)
        if (p00 == RED && p10 == GREEN && p20 == BLUE && p30 == WHITE) {
            Console.WriteLine("[PASS] row0 palette")
        } else {
            Console.WriteLine("[FAIL] row0 got "
                + String_FromInt(p00) + "/" + String_FromInt(p10)
                + "/" + String_FromInt(p20) + "/" + String_FromInt(p30))
        }

        // ── 4. Out-of-bounds returns 0 silently ───────────────

        let outside: int = Image.GetPixel(img, 999, 999)
        if (outside == 0) {
            Console.WriteLine("[PASS] out-of-bounds returns 0")
        } else {
            Console.WriteLine("[FAIL] out-of-bounds got "
                + String_FromInt(outside))
        }

        // ── 5. Mutate + PNG round-trip preserves alpha ────────

        Image.SetPixel(img, 0, 0, MAGENTA_HALF)
        let painted: int = Image.GetPixel(img, 0, 0)
        if (painted == MAGENTA_HALF) {
            Console.WriteLine("[PASS] SetPixel in memory")
        } else {
            Console.WriteLine("[FAIL] SetPixel got "
                + String_FromInt(painted))
        }

        let okPng: bool = Image.SaveAsPng(img, "/tmp/amc_img_test.png")
        if (okPng) {
            Console.WriteLine("[PASS] SaveAsPng")
        } else {
            Console.WriteLine("[FAIL] SaveAsPng: " + Image.LastError(img))
        }

        let reloaded = Image.Load("/tmp/amc_img_test.png")
        let reloadedPixel: int = Image.GetPixel(reloaded, 0, 0)
        if (reloadedPixel == MAGENTA_HALF) {
            Console.WriteLine("[PASS] PNG round-trip preserves alpha")
        } else {
            Console.WriteLine("[FAIL] PNG round-trip got "
                + String_FromInt(reloadedPixel))
        }

        // ── 6. TGA round-trip — also lossless ─────────────────

        Image.SaveAsTga(img, "/tmp/amc_img_test.tga")
        let tga = Image.Load("/tmp/amc_img_test.tga")
        if (Image.IsValid(tga) && Image.GetPixel(tga, 0, 0) == MAGENTA_HALF) {
            Console.WriteLine("[PASS] TGA round-trip")
        } else {
            Console.WriteLine("[FAIL] TGA round-trip")
        }

        // ── 7. JPG round-trip — lossy, only verify geometry ───

        Image.SaveAsJpg(img, "/tmp/amc_img_test.jpg", 90)
        let jpg = Image.Load("/tmp/amc_img_test.jpg")
        if (Image.IsValid(jpg) && Image.Width(jpg) == 4 && Image.Height(jpg) == 2) {
            Console.WriteLine("[PASS] JPG round-trip geometry")
        } else {
            Console.WriteLine("[FAIL] JPG round-trip")
        }

        // ── 8. Explicit Free (idempotent) ─────────────────────

        Image.Free(img)
        if (!Image.IsValid(img)) {
            Console.WriteLine("[PASS] Free invalidates handle")
        } else {
            Console.WriteLine("[FAIL] handle still valid after Free")
        }
        Image.Free(img)
        Console.WriteLine("[PASS] Free is idempotent")

        // ═══════════════════════════════════════════════════════
        //  v0.2 — typed accessors + Create/Fill + Resize/Crop +
        //         Flip/Rotate
        // ═══════════════════════════════════════════════════════

        // ── 9. Create + Fill ──────────────────────────────────

        let canvas = Image.Create(16, 8, BLUE)
        if (Image.IsValid(canvas)
            && Image.Width(canvas) == 16
            && Image.Height(canvas) == 8) {
            Console.WriteLine("[PASS] Create 16x8")
        } else {
            Console.WriteLine("[FAIL] Create geometry")
        }
        if (Image.GetPixel(canvas, 0, 0) == BLUE
            && Image.GetPixel(canvas, 15, 7) == BLUE) {
            Console.WriteLine("[PASS] Create fills with packed colour")
        } else {
            Console.WriteLine("[FAIL] Create fill mismatch")
        }

        Image.Fill(canvas, GREEN)
        if (Image.GetPixel(canvas, 5, 5) == GREEN) {
            Console.WriteLine("[PASS] Fill replaces all pixels")
        } else {
            Console.WriteLine("[FAIL] Fill: got "
                + String_FromInt(Image.GetPixel(canvas, 5, 5)))
        }

        // ── 10. Typed RGBA accessors ──────────────────────────

        Image.SetRGBA(canvas, 3, 4, 200, 100, 50, 255)
        let r3 = Image.GetR(canvas, 3, 4)
        let g3 = Image.GetG(canvas, 3, 4)
        let b3 = Image.GetB(canvas, 3, 4)
        let a3 = Image.GetA(canvas, 3, 4)
        if (r3 == 200 && g3 == 100 && b3 == 50 && a3 == 255) {
            Console.WriteLine("[PASS] SetRGBA + Get[RGBA]")
        } else {
            Console.WriteLine("[FAIL] typed accessors got "
                + String_FromInt(r3) + "/"
                + String_FromInt(g3) + "/"
                + String_FromInt(b3) + "/"
                + String_FromInt(a3))
        }

        // ── 11. Resize ────────────────────────────────────────

        let resized = Image.Resize(canvas, 8, 4)
        if (Image.IsValid(resized)
            && Image.Width(resized) == 8
            && Image.Height(resized) == 4) {
            Console.WriteLine("[PASS] Resize to 8x4")
        } else {
            Console.WriteLine("[FAIL] Resize: "
                + Image.LastError(resized))
        }

        // ── 12. FlipH — pixel at (3,4) moves to (12,4) ────────

        Image.FlipH(canvas)
        let movedR = Image.GetR(canvas, 12, 4)
        if (movedR == 200) {
            Console.WriteLine("[PASS] FlipH moves (3,4) -> (12,4)")
        } else {
            Console.WriteLine("[FAIL] FlipH got R="
                + String_FromInt(movedR))
        }

        // ── 13. FlipV — restore canvas first, then check ──────
        //   canvas right now has the FlipH still applied; FlipV
        //   on top moves the (12,4) pixel to (12, 8-1-4 = 3).

        Image.FlipV(canvas)
        let movedR2 = Image.GetR(canvas, 12, 3)
        if (movedR2 == 200) {
            Console.WriteLine("[PASS] FlipV moves (12,4) -> (12,3)")
        } else {
            Console.WriteLine("[FAIL] FlipV got R="
                + String_FromInt(movedR2))
        }

        // ── 14. Rotate180 = FlipH+FlipV reversed in one pass ──

        let rotCheck = Image.Create(4, 2, GREEN)
        Image.SetRGBA(rotCheck, 0, 0, 255, 0, 0, 255)   // top-left red
        Image.Rotate180(rotCheck)
        // Top-left → bottom-right after 180°.
        if (Image.GetR(rotCheck, 3, 1) == 255
            && Image.GetG(rotCheck, 3, 1) == 0
            && Image.GetB(rotCheck, 3, 1) == 0) {
            Console.WriteLine("[PASS] Rotate180 maps (0,0) -> (3,1)")
        } else {
            Console.WriteLine("[FAIL] Rotate180 wrong dest")
        }

        // ── 15. Crop — sub-rect copy ──────────────────────────

        let cropSrc = Image.Create(10, 10, BLUE)
        Image.SetRGBA(cropSrc, 5, 5, 255, 128, 64, 255)
        let cropped = Image.Crop(cropSrc, 3, 3, 5, 5)
        if (Image.IsValid(cropped)
            && Image.Width(cropped) == 5
            && Image.Height(cropped) == 5
            && Image.GetR(cropped, 2, 2) == 255       // (5,5) src -> (2,2) dst
            && Image.GetG(cropped, 2, 2) == 128
            && Image.GetB(cropped, 2, 2) == 64) {
            Console.WriteLine("[PASS] Crop sub-rect preserves pixels")
        } else {
            Console.WriteLine("[FAIL] Crop mismatch")
        }

        // ── 16. Crop clamps an out-of-range window ────────────

        let clamped = Image.Crop(cropSrc, -5, -5, 4, 4)
        if (Image.IsValid(clamped)
            && Image.Width(clamped) == 4 - 1
            && Image.Height(clamped) == 4 - 1) {
            // window: x=-5..-1 ∩ 0..9 = empty? No: x=-5..-1 → after
            // clamping x0=0, x1=min(-5+4,10)=-1 → invalid window.
            // Crop returns "empty window" error. This branch
            // shouldn't fire; see [FAIL] line below for the path
            // we actually expect.
            Console.WriteLine("[FAIL] Crop should have rejected window")
        } else if (!Image.IsValid(clamped)) {
            Console.WriteLine("[PASS] Crop rejects empty window")
        }
    }
}
